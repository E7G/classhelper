<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />

    <application
        android:name=".ClassHelperApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:label="课堂助手"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClassHelper">

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ChaoxingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ChaoxingMaterialsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ChaoxingWebActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LibraryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ReaderActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".classroom.ClassroomService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".classroom.AsrModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".classroom.AsrModelDownloadJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"
            tools:targetApi="34" />

    </application>
</manifest>
